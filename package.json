{
  "name": "plainsign",
  "version": "0.3.0",
  "private": true,
  "description": "Plain-English safety checks for Ethereum wallet signing requests.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "fixtures:generate": "tsx tests/fixtures/generate.ts",
    "verify:free-mint": "tsx scripts/verify-free-mint.ts",
    "verify:mainnet": "tsx scripts/verify-mainnet.ts",
    "verify:monad": "tsx scripts/verify-monad.ts",
    "verify:alchemy-simulation": "tsx scripts/verify-alchemy-simulation.ts",
    "test:e2e": "cross-env VITE_E2E=1 VITE_LLM_KEY=plainsign-e2e VITE_E2E_MOCK_LLM=1 npm run build && playwright test",
    "test:e2e:sepolia": "node scripts/test-sepolia-e2e.js",
    "screenshots": "cross-env VITE_E2E=1 npm run build && npm --prefix demo-dapp run build && playwright test --config=playwright.screenshots.config.ts",
    "testpage": "node tests/e2e/serve.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/package-extension.js",
    "submission:package": "node scripts/prepare-submission.js",
    "submission:audit": "node scripts/audit-submission.mjs",
    "videos:record": "node scripts/record-submission.mjs",
    "docs:rules": "node scripts/generate-rules-doc.js",
    "qr": "node scripts/generate-qr.js",
    "slides": "node scripts/presentation/build.mjs",
    "verify:all": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e",
    "env:sync": "node scripts/env-sync.js",
    "chain": "node scripts/run-workspace-script.js contracts chain",
    "deploy:local": "node scripts/run-workspace-script.js contracts deploy:local",
    "seed:local": "node scripts/run-workspace-script.js contracts seed:local",
    "deploy:sepolia": "node scripts/run-workspace-script.js contracts deploy:sepolia",
    "preflight:sepolia": "node scripts/run-workspace-script.js contracts preflight:sepolia",
    "dapp:addresses": "node scripts/sync-dapp-addresses.js",
    "demo:local": "node scripts/demo-local.js",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@wxt-dev/module-react": "^1.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.0",
    "@marp-team/marp-cli": "^4.5.1",
    "@playwright/test": "^1.47.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.7.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^2.1.1",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.11.0",
    "globals": "^15.10.0",
    "jsdom": "^25.0.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.1",
    "wxt": "^0.19.0",
    "yauzl": "^2.10.0"
  },
  "engines": {
    "node": "20.x || 22.x"
  }
}
